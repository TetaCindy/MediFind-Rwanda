# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── PostgreSQL Database ───────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medifind_rwanda
DB_USER=medifind_user
DB_PASSWORD=your_postgres_password_here

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=medifind_rwanda_super_secret_2026
JWT_EXPIRES_FACILITY=24h
JWT_EXPIRES_PATIENT=7d

# ─── Email (OTP delivery) ──────────────────────────────────────────────────
# OTP codes are sent by email, not SMS. Use a Gmail account with:
#   1. 2-Step Verification turned on (myaccount.google.com/security)
#   2. An "App Password" generated at myaccount.google.com/apppasswords
# Paste your own Gmail address + the 16-character App Password below.
# In NODE_ENV=development, this is skipped entirely and codes are printed
# to this terminal instead, so email setup is optional for local testing.
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_APP_PASSWORD=your_16_char_app_password

# ─── MTN Rwanda SMS API (unused — kept for reference only) ────────────────
MTN_API_KEY=1AS2fBgxsI74UtAYTMv6luTuOGGBauzo
MTN_API_SECRET=AvYAuEd9P9WEtNO4
SMS_SENDER_ID=MediFind
