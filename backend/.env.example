# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── PostgreSQL Database ───────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medifind_rwanda
DB_USER=medifind_user
DB_PASSWORD=your_secure_password_here

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_key_min_32_chars
JWT_EXPIRES_FACILITY=24h
JWT_EXPIRES_PATIENT=7d

# ─── SMS Gateway (MTN Rwanda / Airtel Rwanda) ─────────────────────────────────
SMS_PROVIDER=mtn
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=MediFind

# ─── Maps API ─────────────────────────────────────────────────────────────────
MAPS_API_KEY=your_google_maps_or_osm_key

# ─── Rwanda FDA PRIMS API ─────────────────────────────────────────────────────
PRIMS_API_URL=https://rwandafda.gov.rw/api
PRIMS_API_KEY=your_prims_api_key
